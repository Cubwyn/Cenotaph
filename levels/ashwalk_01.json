  "dialogues": [
    {
      "id": "arrival_words",
      "speaker": "The Ash-Walk",
      "lines": [
        "Pale waystones climb toward the Anchor.",
        "Nothing else here is a promise."
      ]
    },
    {
      "id": "oath_stone_words",
      "speaker": "Oath Stone",
      "lines": [
        "What is carried may still be lost.",
        "What is remembered may be carried again."
      ]
    },
    {
      "id": "upper_route_warning",
      "speaker": "The Ash-Walk",
      "lines": [
        "The Ash-Warden bears the last chain above the pale stone.",
        "It has forgotten whom the chain was meant to hold."
      ]
    },
    {
      "id": "anchor_words",
      "speaker": "Anchor",
      "lines": [
        "The mountain releases nothing.",
        "For a moment, neither do you."
      ]
    },
    {
      "id": "ashwarden_fall_words",
      "speaker": "The Ash-Walk",
      "lines": [
        "The last chain falls upward.",
        "Something beneath the road has noticed the missing weight."
      ]
    },
    {
      "id": "first_claim_words",
      "speaker": "The First Anchor",
      "lines": [
        "Your Ash is bound. Your ascent is not.",
        "The mountain will remember this claim incorrectly."
      ]
    }
  ]
